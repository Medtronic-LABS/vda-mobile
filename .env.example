# ==============================================================================
# VDA Health Assistant - Environment Configuration
# ==============================================================================

# Backend API Base URL (leave blank to run in offline standalone mock mode)
# In development: http://localhost:5000
# In production on device / emulator: http://10.0.2.2:5000 (Android Emulator) OR https://your-backend.com
VITE_API_BASE_URL=""

# When backend is unreachable or offline, allow fallback to synthetic data (true/false)
VITE_ENABLE_MOCK_FALLBACK="true"

# Google Gemini API Key for direct or server-side Gemini 2.0 health assistance
GEMINI_API_KEY=""

# Backend server port (defaults to 5000)
PORT=5000

# Public App Hosting URL
APP_URL="http://localhost:3000"
